{
  "appId": "com.kalichindi.inventory",
  "productName": "Kalichindi Inventory System",
  "directories": {
    "buildResources": "public",
    "output": "dist"
  },
  "files": [
    "build/**/*",
    "public/electron.js",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/dist",
      "to": "backend",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kalichindi Inventory"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "public/icon.icns",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "public/icon.png",
    "category": "Office"
  }
}